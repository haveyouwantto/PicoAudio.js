{
  "name": "@maple-kaede/picoaudio",
  "version": "3.0.0",
  "description": "PicoAudio.js is light MIDI player using Web Audio API",
  "main": "dist/nodejs/picoaudio.js",
  "module": "dist/nodejs/picoaudio.mjs",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:full": "rollup -c --environment PICO_VARIANTS:full",
    "build:sf2": "rollup -c --environment PICO_VARIANTS:sf2",
    "build:sf2-wave-nodefault": "rollup -c --environment PICO_VARIANTS:sf2-wave-nodefault",
    "build:wave": "rollup -c --environment PICO_VARIANTS:wave",
    "build:wave-nodefault": "rollup -c --environment PICO_VARIANTS:wave-nodefault",
    "build:basic": "rollup -c --environment PICO_VARIANTS:basic",
    "build:map": "rollup -cm",
    "watch": "rollup -mw -c watch.rollup.config.js",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haveyouwantto/PicoAudio.js.git"
  },
  "bugs": {
    "url": "https://github.com/haveyouwantto/PicoAudio.js/issues"
  },
  "homepage": "https://github.com/haveyouwantto/PicoAudio.js#readme",
  "keywords": [
    "midi",
    "smf",
    "chiptune",
    "web audio api",
    "web-audio-api",
    "web midi api",
    "web-midi-api"
  ],
  "author": "Maple-Kaede <haveyouwantto@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.11.1",
    "@babel/preset-env": "^7.11.0",
    "@rollup/plugin-babel": "^5.1.0",
    "core-js": "^3.6.5",
    "eslint": "^8.4.1",
    "rollup": "^2.23.1",
    "rollup-plugin-livereload": "^1.3.0",
    "rollup-plugin-serve": "^1.0.3",
    "rollup-plugin-terser": "^7.0.0"
  },
  "dependencies": {
    "protobufjs": "^7.2.5",
    "protobufjs-cli": "^1.1.2"
  }
}
